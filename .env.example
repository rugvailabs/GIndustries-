# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real API keys.

# Required for the /contact page form to actually send email.
# Sign up at https://resend.com, verify a sending domain (or use the
# resend.dev sandbox address below for testing), and create an API key
# under Dashboard > API Keys.
RESEND_API_KEY=

# Optional — the "From" address emails are sent from. Must be on a domain
# verified in your Resend account. Leave unset to use Resend's sandbox
# address (onboarding@resend.dev), which works without domain verification
# but is best for testing only.
RESEND_FROM_EMAIL="G Industries Website <onboarding@resend.dev>"

# Required for the /admin CMS. Postgres connection string (Neon or any
# Postgres host works — this is plain `pg`, not Neon-locked).
DATABASE_URL=

# Required for the /admin CMS. Signing secret for Auth.js sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Required for the /admin CMS to upload/manage images. Create a free
# account at https://cloudinary.com and copy these from your Dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
